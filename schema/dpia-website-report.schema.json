{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpdpasupport.com/schemas/dpia-website-report.schema.json",
  "title": "Website DPIA Advisory Readiness Assessment Report",
  "description": "Deterministic, reputation-safe Website Data Protection Impact Assessment (DPIA) & Automation Readiness Schema aligned with the Digital Personal Data Protection Act, 2023 (9 Chapters, 44 Sections, 1 Schedule) and the Digital Personal Data Protection Rules, 2025 (G.S.R. 846(E), notified 13 Nov 2025; 23 Rules, 7 Schedules). Compatible across Claude, Google Gemini, DeepSeek, and Qwen.",
  "type": "object",
  "required": [
    "report_metadata",
    "executive_readiness_summary",
    "pre_consent_storage_and_cookies",
    "website_automations_and_profiling_inventory",
    "statutory_dpdpa_control_matrix",
    "advisory_findings",
    "subprocessor_and_cross_border_register",
    "reputation_safety_attestation"
  ],
  "additionalProperties": false,
  "properties": {
    "report_metadata": {
      "type": "object",
      "required": [
        "audit_id",
        "target_url",
        "canonical_domain",
        "evaluated_at_utc",
        "assessment_framing",
        "audit_scope",
        "statutory_baseline",
        "evaluating_model_family"
      ],
      "additionalProperties": false,
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Deterministic or UUID identifier for the audit run."
        },
        "target_url": {
          "type": "string",
          "format": "uri",
          "description": "Exact website URL inspected in read-only mode."
        },
        "canonical_domain": {
          "type": "string",
          "description": "Hostname of the inspected website."
        },
        "evaluated_at_utc": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC timestamp of telemetry capture."
        },
        "assessment_framing": {
          "type": "string",
          "const": "Confidential & Constructive Advisory DPIA Readiness Assessment"
        },
        "audit_scope": {
          "type": "string",
          "const": "Publicly observable client-side DOM, HTTP response headers, pre-consent storage, network requests, and website automation signals (Read-Only Website Scope)"
        },
        "statutory_baseline": {
          "type": "object",
          "required": [
            "act",
            "rules",
            "enforcement_timeline",
            "grievance_sla_days",
            "security_log_retention_minimum"
          ],
          "additionalProperties": false,
          "properties": {
            "act": {
              "type": "string",
              "const": "Digital Personal Data Protection Act, 2023 (No. 22 of 2023; 9 Chapters, 44 Sections, 1 Schedule)"
            },
            "rules": {
              "type": "string",
              "const": "Digital Personal Data Protection Rules, 2025 (G.S.R. 846(E), notified 13 November 2025; 23 Rules, 7 Schedules)"
            },
            "enforcement_timeline": {
              "type": "string",
              "const": "Phased: 13 Nov 2025 (Rules 1-2, 17-21); 13 Nov 2026 (Rule 4 Consent Manager registration); 13 May 2027 (Rules 3, 5-16, 22-23 operational compliance)"
            },
            "grievance_sla_days": {
              "type": "integer",
              "const": 90,
              "description": "Rule 14(3) mandates grievance resolution within a period not exceeding 90 days."
            },
            "security_log_retention_minimum": {
              "type": "string",
              "const": "Minimum 1 year (Rule 8(3) read with Seventh Schedule)"
            }
          }
        },
        "evaluating_model_family": {
          "type": "string",
          "enum": [
            "claude",
            "gemini",
            "deepseek",
            "qwen",
            "deterministic-telemetry-only"
          ]
        }
      }
    },
    "executive_readiness_summary": {
      "type": "object",
      "required": [
        "overall_readiness_score_0_100",
        "readiness_posture",
        "rule13_dpia_and_algorithmic_risk_triggered",
        "rule13_trigger_rationale",
        "key_observed_strengths",
        "priority_readiness_enhancements",
        "board_advisory_synopsis"
      ],
      "additionalProperties": false,
      "properties": {
        "overall_readiness_score_0_100": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "readiness_posture": {
          "type": "string",
          "enum": [
            "High Readiness (Aligned)",
            "Moderate Readiness (Advisory Enhancements Recommended)",
            "Foundational Readiness (Priority Engineering Actions Recommended)"
          ]
        },
        "rule13_dpia_and_algorithmic_risk_triggered": {
          "type": "boolean",
          "description": "True if observed website automations, AI chatbots, session replay, cross-site profiling, or high-volume tracking warrant a formal Rule 13(1)-(3) DPIA and algorithmic software risk assessment."
        },
        "rule13_trigger_rationale": {
          "type": "string"
        },
        "key_observed_strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority_readiness_enhancements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "board_advisory_synopsis": {
          "type": "string",
          "description": "Neutral, non-accusatory executive summary suitable for CISO, DPO, General Counsel, and Engineering leads."
        }
      }
    },
    "pre_consent_storage_and_cookies": {
      "type": "object",
      "required": [
        "pre_consent_tracking_observed",
        "first_party_cookies_count",
        "third_party_cookies_count",
        "cookies_inventory",
        "local_storage_keys",
        "session_storage_keys",
        "indexeddb_databases",
        "service_workers_registered"
      ],
      "additionalProperties": false,
      "properties": {
        "pre_consent_tracking_observed": {
          "type": "boolean",
          "description": "True if non-essential analytics, advertising, session replay, or profiling cookies/storage keys are set prior to affirmative user consent."
        },
        "first_party_cookies_count": {
          "type": "integer",
          "minimum": 0
        },
        "third_party_cookies_count": {
          "type": "integer",
          "minimum": 0
        },
        "cookies_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "domain",
              "is_third_party",
              "category",
              "http_only",
              "secure",
              "same_site",
              "expiry_days",
              "set_before_consent"
            ],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "domain": { "type": "string" },
              "is_third_party": { "type": "boolean" },
              "category": {
                "type": "string",
                "enum": [
                  "Strictly Necessary / Security",
                  "Functional / Preferences",
                  "Analytics & Telemetry",
                  "Marketing / Ad-Tech / Retargeting",
                  "Session Replay / Behavioral Profiling",
                  "AI / Chat / Support Automation",
                  "Unclassified"
                ]
              },
              "http_only": { "type": "boolean" },
              "secure": { "type": "boolean" },
              "same_site": { "type": "string" },
              "expiry_days": { "type": "number" },
              "set_before_consent": { "type": "boolean" }
            }
          }
        },
        "local_storage_keys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "session_storage_keys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "indexeddb_databases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "service_workers_registered": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "website_automations_and_profiling_inventory": {
      "type": "object",
      "description": "Comprehensive inventory of client-side automations, marketing/CRM trackers, session replay, AI agents, pixels, and form listeners relevant to Section 6, Section 8(5), and Rule 13(2) algorithmic risk assessment.",
      "required": [
        "total_automations_detected",
        "marketing_and_crm_automations",
        "cdp_and_tag_managers",
        "session_replay_and_heatmaps",
        "ai_chatbots_and_support_widgets",
        "ad_pixels_and_auto_advanced_matching",
        "form_input_and_dark_pattern_signals",
        "fingerprinting_and_background_signals"
      ],
      "additionalProperties": false,
      "properties": {
        "total_automations_detected": {
          "type": "integer",
          "minimum": 0
        },
        "marketing_and_crm_automations": {
          "type": "array",
          "items": { "$ref": "#/$defs/automation_item" }
        },
        "cdp_and_tag_managers": {
          "type": "array",
          "items": { "$ref": "#/$defs/automation_item" }
        },
        "session_replay_and_heatmaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/automation_item" }
        },
        "ai_chatbots_and_support_widgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/automation_item" }
        },
        "ad_pixels_and_auto_advanced_matching": {
          "type": "array",
          "items": { "$ref": "#/$defs/automation_item" }
        },
        "form_input_and_dark_pattern_signals": {
          "type": "object",
          "required": [
            "forms_inspected_count",
            "pre_ticked_checkboxes_count",
            "bundled_consent_forms_count",
            "unencrypted_or_insecure_form_actions",
            "early_field_capture_listeners_detected",
            "observations"
          ],
          "additionalProperties": false,
          "properties": {
            "forms_inspected_count": { "type": "integer", "minimum": 0 },
            "pre_ticked_checkboxes_count": { "type": "integer", "minimum": 0 },
            "bundled_consent_forms_count": { "type": "integer", "minimum": 0 },
            "unencrypted_or_insecure_form_actions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "early_field_capture_listeners_detected": { "type": "boolean" },
            "observations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "fingerprinting_and_background_signals": {
          "type": "object",
          "required": [
            "web_push_permission_requested_on_load",
            "canvas_or_webgl_fingerprint_signals",
            "navigator_beacon_or_fetch_keepalive_observed",
            "details"
          ],
          "additionalProperties": false,
          "properties": {
            "web_push_permission_requested_on_load": { "type": "boolean" },
            "canvas_or_webgl_fingerprint_signals": { "type": "boolean" },
            "navigator_beacon_or_fetch_keepalive_observed": { "type": "boolean" },
            "details": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "statutory_dpdpa_control_matrix": {
      "type": "object",
      "required": [
        "section_5_rule_3_notice",
        "section_6_rule_3_4_consent_and_cmp",
        "section_8_5_rule_6_8_security_and_logs",
        "section_9_rules_10_11_children_safeguards",
        "section_10_rule_13_dpia_and_algorithmic_governance",
        "section_13_rule_14_3_grievance_and_dpo",
        "section_16_rule_15_cross_border_transfers"
      ],
      "additionalProperties": false,
      "properties": {
        "section_5_rule_3_notice": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_6_rule_3_4_consent_and_cmp": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_8_5_rule_6_8_security_and_logs": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_9_rules_10_11_children_safeguards": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_10_rule_13_dpia_and_algorithmic_governance": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_13_rule_14_3_grievance_and_dpo": { "$ref": "#/$defs/control_pillar_assessment" },
        "section_16_rule_15_cross_border_transfers": { "$ref": "#/$defs/control_pillar_assessment" }
      }
    },
    "advisory_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "pillar",
          "observed_technical_signal",
          "statutory_mapping",
          "readiness_tier",
          "reputation_safe_advisory_note",
          "recommended_engineering_fix",
          "verification_method"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^DPIA-[0-9]{3}$"
          },
          "pillar": {
            "type": "string",
            "enum": [
              "Notice & Transparency (Sec 5 / Rule 3)",
              "Consent & Dark-Pattern Symmetry (Sec 6 / Rules 3-4)",
              "Website Automations, AI & Profiling (Sec 6 / Rule 13(2))",
              "Reasonable Security Safeguards (Sec 8(5) / Rule 6)",
              "Children's Data Protection (Sec 9 / Rules 10-11)",
              "Grievance Redressal & 90-Day SLA (Sec 13 / Rule 14(3))",
              "Cross-Border Sub-Processors (Sec 16 / Rule 15)"
            ]
          },
          "observed_technical_signal": {
            "type": "string",
            "description": "Exact empirical evidence observed from DOM, HTTP headers, cookies, or network requests. Never fabricate signals."
          },
          "statutory_mapping": {
            "type": "string",
            "description": "Exact citation to DPDP Act, 2023 Section and DPDP Rules, 2025 (G.S.R. 846(E)) Rule."
          },
          "readiness_tier": {
            "type": "string",
            "enum": [
              "Aligned",
              "Advisory Enhancement",
              "Priority Readiness Action"
            ]
          },
          "reputation_safe_advisory_note": {
            "type": "string",
            "description": "Constructive, non-accusatory explanation of the observation and its DPIA readiness implication."
          },
          "recommended_engineering_fix": {
            "type": "string",
            "description": "Concrete, actionable engineering or governance configuration step."
          },
          "verification_method": {
            "type": "string",
            "description": "How engineering/DPO teams can re-verify this control after deployment."
          }
        }
      }
    },
    "subprocessor_and_cross_border_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "third_party_domain",
          "vendor_or_service_name",
          "category",
          "estimated_primary_jurisdiction",
          "fired_before_consent",
          "dpdpa_governance_recommendation"
        ],
        "additionalProperties": false,
        "properties": {
          "third_party_domain": { "type": "string" },
          "vendor_or_service_name": { "type": "string" },
          "category": { "type": "string" },
          "estimated_primary_jurisdiction": { "type": "string" },
          "fired_before_consent": { "type": "boolean" },
          "dpdpa_governance_recommendation": { "type": "string" }
        }
      }
    },
    "reputation_safety_attestation": {
      "type": "object",
      "required": [
        "zero_defamation_verified",
        "prohibited_terms_absent",
        "read_only_passive_inspection_confirmed",
        "disclaimer"
      ],
      "additionalProperties": false,
      "properties": {
        "zero_defamation_verified": { "type": "boolean", "const": true },
        "prohibited_terms_absent": { "type": "boolean", "const": true },
        "read_only_passive_inspection_confirmed": { "type": "boolean", "const": true },
        "disclaimer": {
          "type": "string",
          "const": "This report is a confidential, read-only technical DPIA readiness assessment based solely on publicly observable client-side website signals at the timestamp of inspection. It does not constitute a legal opinion or statutory certification, and makes no representation regarding backend/internal organisational controls."
        }
      }
    }
  },
  "$defs": {
    "automation_item": {
      "type": "object",
      "required": [
        "vendor_name",
        "automation_category",
        "matched_signal",
        "loaded_before_consent",
        "rule13_2_profiling_or_automated_risk_relevance",
        "advisory_governance_action"
      ],
      "additionalProperties": false,
      "properties": {
        "vendor_name": { "type": "string" },
        "automation_category": {
          "type": "string",
          "enum": [
            "Marketing & CRM Automation",
            "CDP & Event Routing",
            "Session Replay & Behavioral Heatmap",
            "AI Chatbot / Conversational Agent / Support Widget",
            "Ad Pixel / Auto-Advanced Matching / Retargeting",
            "Push / Background / Custom Automation"
          ]
        },
        "matched_signal": {
          "type": "string",
          "description": "Exact script URL, global window variable, or DOM selector observed."
        },
        "loaded_before_consent": { "type": "boolean" },
        "rule13_2_profiling_or_automated_risk_relevance": {
          "type": "string",
          "description": "Assessment of how this automation impacts Data Principal privacy under Section 6 and Rule 13(2)."
        },
        "advisory_governance_action": { "type": "string" }
      }
    },
    "control_pillar_assessment": {
      "type": "object",
      "required": [
        "statutory_reference",
        "readiness_tier",
        "observed_signals",
        "advisory_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "statutory_reference": { "type": "string" },
        "readiness_tier": {
          "type": "string",
          "enum": [
            "Aligned",
            "Advisory Enhancement",
            "Priority Readiness Action"
          ]
        },
        "observed_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "advisory_summary": { "type": "string" }
      }
    }
  }
}
